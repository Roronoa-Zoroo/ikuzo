{
  "name": "@repo/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./papr": {
      "types": "./src/papr.ts",
      "default": "./dist/papr.js"
    },
    "./models/*": {
      "types": "./src/models/*.ts",
      "default": "./dist/models/*.js"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts",
      "default": "./dist/lifecycle.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@repo/runtime": "workspace:*",
    "mongodb": "^7.8.0",
    "papr": "^17.1.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
