{
  "name": "@repo/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./http": {
      "types": "./src/http.ts",
      "default": "./dist/http.js"
    },
    "./invariant": {
      "types": "./src/invariant.ts",
      "default": "./dist/invariant.js"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts",
      "default": "./dist/lifecycle.js"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./dist/logger.js"
    },
    "./boot": {
      "types": "./src/boot.ts",
      "default": "./dist/boot.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
