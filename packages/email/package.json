{
  "name": "@repo/email",
  "version": "1.0.0",
  "private": true,
  "description": "React Email templates and a Resend mailer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/mailer.ts",
      "default": "./dist/mailer.js"
    },
    "./emails/*": {
      "types": "./src/emails/*.tsx",
      "default": "./dist/emails/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "clean": "tsc --build --clean",
    "preview": "email dev --dir ./src/emails"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.9.5",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.5",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
