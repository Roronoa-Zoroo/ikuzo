# AniList and MyAnimeList sign-in. Defaults are the official Ikuzo clients; forks
# should register their own (redirect URLs: ikuzo://auth/anilist, ikuzo://auth/mal).
EXPO_PUBLIC_ANILIST_CLIENT_ID=
EXPO_PUBLIC_MAL_CLIENT_ID=

# Optional: AniDB episode data. Register a client at https://anidb.net/software/add
# (type: "HTTP API"), then put its name and version here. Leave empty to disable AniDB.
EXPO_PUBLIC_ANIDB_CLIENT=
EXPO_PUBLIC_ANIDB_CLIENT_VERSION=1
