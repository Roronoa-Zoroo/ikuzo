{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "clean": "tsc --build --clean",
    "dev": "portless run --name api.starter node --watch-preserve-output --watch-path=src --env-file=.env src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.15",
    "@better-auth/redis-storage": "^1.7.15",
    "@hono/node-server": "^2.1.6",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/runtime": "workspace:*",
    "@repo/storage": "workspace:*",
    "@trpc/server": "^11.23.0",
    "better-auth": "^1.7.15",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "mongodb": "^7.8.0",
    "papr": "^17.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
